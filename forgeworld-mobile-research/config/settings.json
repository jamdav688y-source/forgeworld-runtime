{
  "application_name": "ForgeWorld Mobile Research Companion",
  "host": "127.0.0.1",
  "port": 5055,
  "debug": false,
  "database_path": "runtime/database/forgeworld_research.db",
  "sqlite_wal": true,
  "sqlite_busy_timeout_ms": 5000,
  "manual_scan_default": true,
  "max_initial_batch": 5,
  "max_normal_batch": 25,
  "max_preview_dimension": 1280,
  "max_ocr_dimension": 2200,
  "ocr_jobs_parallel": 1,
  "ocr_language": "eng",
  "ocr_timeout_seconds": 45,
  "preserve_originals": true,
  "skip_existing_hashes": true,
  "cloud_uploads_enabled": false,
  "execute_ocr_text": false,
  "semantic_search_enabled": false,
  "bounded_polling_enabled": false,
  "bounded_polling_interval_seconds": 300,
  "scheduled_scan_enabled": false
}
